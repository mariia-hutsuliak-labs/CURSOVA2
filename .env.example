# Приклад локальної конфігурації. Скопіюйте у .env і заповніть власними значеннями.
# Реальні значення НЕ комітити: файл .env у .gitignore.
SECRET_KEY=change-me
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DBNAME
POOL_RECYCLE=300
DEMO_API_TOKEN=
# Поріг низького залишку товару (ціле число >= 0). Некоректне значення зупиняє запуск.
LOW_STOCK_THRESHOLD=5
# Формат логів: text (за замовчуванням) або json. Необов'язково.
LOG_FORMAT=text
# Додатковий файл журналу (на додачу до stderr). Необов'язково.
LOG_FILE=
# Імітація збою БД для демонстрацій стійкості (ЛР2): none | error | timeout.
DB_FAULT_MODE=none
